# 私有部署环境变量模板
# 使用前：cp .env.private.example .env.private
# 然后填入真实值，不要提交 .env.private 到 git

# ── 数据库 ──────────────────────────────────────────
DB_USER=opengit
DB_PASSWORD=change_me_strong_password
DB_NAME=opengit

# ── 安全密钥（必填，建议 64 位随机字符串）────────────
# 生成方式：openssl rand -hex 32
JWT_SECRET=change_me_64_char_random_string
INTERNAL_API_TOKEN=change_me_internal_token

# ── 微信（不用微信认领可以随便填）──────────────────
WECHAT_TOKEN=change_me_wechat_token

# ── 前端地址（用于认领成功后跳转）──────────────────
FRONTEND_URL=http://localhost

# ── 监听端口 ────────────────────────────────────────
LISTEN_PORT=80

# ── 治理模式（off / observe / enforce）──────────────
APP_GOVERNANCE_MODE=off
